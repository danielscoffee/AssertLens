{
  "name": "assertlens",
  "version": "0.1.0",
  "type": "module",
  "description": "Local correctness checks and advisory Jev pull-request review.",
  "keywords": [
    "assertions",
    "code-review",
    "bubblewrap",
    "sandbox",
    "github-actions",
    "jev",
    "typesafe"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielscoffee/AssertLens.git"
  },
  "homepage": "https://danielscoffee.github.io/AssertLens/",
  "bugs": "https://github.com/danielscoffee/AssertLens/issues",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "assertlens": "./dist/assertlens.js"
  },
  "exports": {
    ".": {
      "types": "./dist/assertlens.d.ts",
      "default": "./dist/assertlens.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "review": "node src/assertlens.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
